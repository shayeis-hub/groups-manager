rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mirror lib/dietitians.ts DIETITIANS emails exactly — this is the real
    // enforcement, the client-side list is only a UI-routing convenience.
    function isDietitian() {
      return request.auth != null && request.auth.token.email in ['galit.g@leptin4life.com', 'rotem.st@leptin4life.com', 'shayeis@gmail.com'];
    }

    match /groups/{groupId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isDietitian());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Written by the app, consumed by the local WhatsApp bridge service
    // (which uses the Admin SDK and so bypasses these rules entirely).
    // Clients may create/read/edit/delete only their own commands, and only
    // while still 'pending' — once the bridge claims one (status flips to
    // 'processing') these rules lock it, so an edit/delete request racing
    // the bridge just fails instead of corrupting an in-flight send.
    match /whatsappCommands/{commandId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isDietitian());
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid
        && resource.data.status == 'pending';
    }

    // One doc per coach. Only the bridge service (Admin SDK, bypasses rules)
    // sets status/qr/groups — the client's only legitimate write is bumping
    // requestedAt to ask the bridge to open a connection.
    match /whatsappSessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Reusable message+attachment library, applied in bulk to a group to
    // pre-schedule a whole program's worth of sends. Shared across every
    // coach (not scoped by uid) — the whole point is that one coach's set is
    // reusable by the others. `uid` on each doc is who created it, kept only
    // as info, not for access control.
    match /messageTemplates/{templateId} {
      allow read, write: if request.auth != null;
    }

    // Named batches of templates (e.g. "קיץ - Start" vs "חורף - Start") that
    // messageTemplates docs reference by setId. Shared, same reasoning.
    match /templateSets/{setId} {
      allow read, write: if request.auth != null;
    }

    match /plans/{planId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /clients/{clientId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isDietitian());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /dietitianSessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/clients/$(clientId)).data.userId || isDietitian());
        allow create: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/clients/$(clientId)).data.userId || isDietitian());
        allow update, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/clients/$(clientId)).data.userId;
      }

      match /coachSessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/clients/$(clientId)).data.userId || isDietitian());
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/clients/$(clientId)).data.userId;
      }
    }
  }
}
